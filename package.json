{
  "name": "awesome-ai-tools",
  "version": "0.1.0",
  "description": "Curated AI tools directory powered by LobeHub Icons — 收录 1600+ AI 工具官网的开源导航站",
  "license": "MIT",
  "private": false,
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "sync:icons": "tsx scripts/sync-icons.ts",
    "backfill:added-at": "tsx scripts/backfill-added-at.ts",
    "audit:curation": "tsx scripts/audit-curation.ts",
    "audit:categories": "tsx scripts/audit-categories.ts",
    "audit:tags": "tsx scripts/audit-tags.ts",
    "migrate:meta": "tsx scripts/migrate-meta.ts",
    "build:contributors": "tsx scripts/build-contributors.ts",
    "check:links": "tsx scripts/check-links.ts",
    "pages:build": "npx --yes @cloudflare/next-on-pages@1",
    "validate:data": "tsx scripts/validate-data.ts",
    "build:search": "tsx scripts/build-search-index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare": "husky || true"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,css}": [
      "prettier --write"
    ],
    "data/**/*.json": [
      "tsx scripts/validate-data.ts"
    ]
  },
  "dependencies": {
    "@lobehub/icons": "^1.0.0",
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-dropdown-menu": "^2.1.2",
    "@radix-ui/react-separator": "^1.1.0",
    "@radix-ui/react-slot": "^1.1.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fuse.js": "^7.0.0",
    "lucide-react": "^0.469.0",
    "next": "^15.5.0",
    "next-themes": "^0.4.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwind-merge": "^2.5.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.6.0",
    "@commitlint/config-conventional": "^19.6.0",
    "@eslint/eslintrc": "^3.2.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.15.0",
    "eslint-config-next": "^15.5.0",
    "eslint-config-prettier": "^9.1.0",
    "husky": "^9.1.7",
    "jsdom": "^25.0.1",
    "lint-staged": "^15.2.11",
    "postcss": "^8.5.0",
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.6.9",
    "tailwindcss": "3.4.17",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
